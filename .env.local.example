# ----------------------------------------------------------------------------
# PRASM Foundation — environment configuration
# Copy to `.env.local` for local dev, and set the same keys in Vercel
# (Production + Preview) before launch. All keys are NEXT_PUBLIC_* because the
# values are public by nature (donation links shown to visitors).
# Leave a key blank to hide/disable that option (it shows as a labeled
# placeholder in dev, and is hidden in production).
# ----------------------------------------------------------------------------

# Canonical site URL — used for metadata, canonical tags, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://prasm.example.org

# --- Donations -------------------------------------------------------------
# Patreon page URL.
NEXT_PUBLIC_PATREON_URL=
# Stripe-hosted Payment Link (one-time or recurring). Create in Stripe Dashboard.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# PayPal.me link, e.g. https://paypal.me/yourhandle
NEXT_PUBLIC_PAYPAL_ME=
# Crypto wallet addresses. Note the network in the UI (esp. USDT).
NEXT_PUBLIC_CRYPTO_BTC_ADDRESS=
NEXT_PUBLIC_CRYPTO_ETH_ADDRESS=
NEXT_PUBLIC_CRYPTO_USDT_ADDRESS=
NEXT_PUBLIC_CRYPTO_USDT_NETWORK=TRC20

# Western Union recipient (sensitive — set in Vercel secrets, do NOT commit
# real values). Shown only if BOTH are set; framed as "message us first".
NEXT_PUBLIC_WU_RECIPIENT_NAME=
NEXT_PUBLIC_WU_RECIPIENT_LOCATION=

# --- Contact / newsletter (no backend) -------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=mahkha420@gmail.com
# Optional Formspree endpoint for the contact form (https://formspree.io/f/xxxx).
# If unset, the contact form falls back to a mailto: link.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
# Optional newsletter provider form-action URL (Buttondown/Mailchimp embed).
# If unset, the newsletter field falls back to a mailto: link.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# --- Analytics -------------------------------------------------------------
# Set to "true" to mount Vercel Web Analytics + Speed Insights (cookieless).
NEXT_PUBLIC_ANALYTICS_ENABLED=false
